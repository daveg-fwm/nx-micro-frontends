{
  "name": "dogs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "zephyr:dependencies": {
    "breeds": "workspace:*",
    "subBreeds": "workspace:*"
  },
  "nx": {
    "name": "dogs",
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rsbuild",
          "cwd": "apps/dogs"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rsbuild build",
          "cwd": "apps/dogs"
        },
        "dependsOn": [
          {
            "target": "build",
            "projects": "breeds"
          },
          {
            "target": "build",
            "projects": "subBreeds"
          }
        ]
      },
      "format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prettier --write .",
          "cwd": "apps/dogs"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint --fix .",
          "cwd": "apps/dogs"
        }
      },
      "preview": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rsbuild preview",
          "cwd": "apps/dogs"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rstest",
          "cwd": "apps/dogs"
        }
      },
      "test:watch": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rstest --watch",
          "cwd": "apps/dogs"
        }
      }
    }
  }
}
